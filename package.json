{
  "name": "campus-clash",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "test:matching": "node scripts/test-matching-concurrency.mjs",
    "test:event-capacity": "node scripts/test-event-capacity-concurrency.mjs",
    "test:social-concurrency": "node scripts/test-social-concurrency.mjs",
    "test:recommendations": "node scripts/evaluate-recommendations.mjs scripts/fixtures/recommendation-evaluation.json --assert-fixture",
    "test:functions": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "preview:phones": "node scripts/capture-phone-previews.cjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.generated.ts && cp src/types/database.generated.ts supabase/functions/_shared/database.types.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.95.0",
    "@tanstack/query-async-storage-persister": "^5.90.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-query-persist-client": "^5.90.0",
    "date-fns": "^4.1.0",
    "expo": "~57.0.14",
    "expo-calendar": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.11",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.0",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.12.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "supabase": "^2.72.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
