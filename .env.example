# Mobile-safe values. Never put a Supabase secret/service-role key in EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
EXPO_PUBLIC_UNIVERSITY_EMAIL_DOMAIN=example.edu
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SENTRY_DSN=

# Edge Function secrets are set with `supabase secrets set`; they are not bundled.
EXPO_ACCESS_TOKEN=
CHECKIN_TOKEN_PEPPER=replace-with-a-long-random-secret
