# Runtime target. Local work defaults to development when omitted.
# The EAS staging-development/production profiles set this and fail closed.
EXPO_PUBLIC_APP_ENV=development

# Mobile-safe public values. Never put a secret/service-role key in EXPO_PUBLIC_*.
# For intentional local demo mode, leave BOTH Supabase values empty.
# For connected development, set BOTH to values from `npx supabase status -o env`
# or your development Supabase project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for staging/production; must match https://<ref>.supabase.co exactly.
EXPO_PUBLIC_SUPABASE_PROJECT_REF=
EXPO_PUBLIC_UNIVERSITY_EMAIL_DOMAIN=example.edu
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SENTRY_DSN=

# Edge Function secrets are set interactively or in the Supabase dashboard; they are
# never mobile environment variables and must not be committed in this file.
EXPO_ACCESS_TOKEN=
CHECKIN_TOKEN_PEPPER=replace-with-a-long-random-secret
CRON_SECRET=replace-with-an-independent-long-random-secret
